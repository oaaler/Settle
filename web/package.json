{
  "name": "settle-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "openapi-typescript ../Server/Sources/SettleAPI/openapi.yaml -o src/lib/api-schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
